<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's own privacy manifest. Plugins ship their own for the APIs they
     call; this one declares the required-reason APIs in our Swift:
     MainFlutterWindow.swift keeps the window's frame and fullscreen state in
     the app's own UserDefaults, reason CA92.1.
     Collected data: what a hosted account stores on Invoice Ninja's servers
     (its users' and clients' names, emails, phones and addresses; invoices,
     payments and other financial records; emails the user sends; photos and
     documents attached to records, whose GPS data is kept; device contacts the
     user syncs; Contact Us messages; the account's user id; the plan bought in
     the app), all linked to the account, and crash and diagnostic
     reports, which carry no user identity. None is used for tracking; all is
     for app functionality, crash data also for analytics. Keep in step with
     the App Store privacy answers (store-compliance-answers.md). -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
